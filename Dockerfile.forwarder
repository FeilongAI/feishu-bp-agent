FROM node:22-alpine

ARG LARK_CLI_VERSION=1.0.83

RUN npm install --global --no-audit --no-fund "@larksuite/cli@${LARK_CLI_VERSION}" \
    && lark-cli --version

WORKDIR /app

ENV NODE_ENV=production \
    HOME=/home/app \
    LARK_CLI_BIN=lark-cli \
    LARK_EVENT_KEY=im.message.receive_v1 \
    FORWARDER_CORE_URL=http://feishu-bp-agent:8090 \
    FORWARDER_HEALTH_HOST=0.0.0.0 \
    FORWARDER_HEALTH_PORT=8091 \
    FORWARDER_SPOOL_DIR=/var/lib/feishu-bp-forwarder/spool

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

COPY src ./src
COPY forwarder-entrypoint.sh /usr/local/bin/feishu-bp-forwarder-entrypoint

RUN addgroup -S app && adduser -S app -G app \
    && mkdir -p /home/app/.lark-cli /var/lib/feishu-bp-forwarder/spool \
    && chown -R app:app /app /home/app /var/lib/feishu-bp-forwarder \
    && chmod 700 /home/app/.lark-cli /var/lib/feishu-bp-forwarder /var/lib/feishu-bp-forwarder/spool \
    && chmod +x /usr/local/bin/feishu-bp-forwarder-entrypoint

USER app

EXPOSE 8091

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://127.0.0.1:8091/healthz || exit 1

ENTRYPOINT ["feishu-bp-forwarder-entrypoint"]
