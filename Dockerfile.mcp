FROM node:22-bookworm-slim

ARG LARK_MCP_VERSION=0.5.1

RUN npm install --global --no-audit --no-fund "@larksuiteoapi/lark-mcp@${LARK_MCP_VERSION}"

RUN groupadd --system app && useradd --system --gid app --create-home --home-dir /home/app app

ENV APP_ID= \
    APP_SECRET= \
    LARK_DOMAIN=https://open.feishu.cn \
    LARK_TOKEN_MODE=tenant_access_token \
    LARK_TOOLS=

EXPOSE 3000

USER app

ENTRYPOINT ["lark-mcp", "mcp"]
CMD ["--mode", "streamable", "--host", "0.0.0.0", "--port", "3000", "--language", "zh", "--tool-name-case", "snake"]
