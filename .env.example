# Storage and service authentication
POSTGRES_PASSWORD=replace_with_url_safe_alphanumeric_password
DATABASE_URL=postgresql://feishu_bp_agent:change_me@127.0.0.1:5432/feishu_bp_agent
ADMIN_API_KEY=replace_with_at_least_24_random_characters
INGRESS_API_KEY=replace_with_a_different_24_char_key
INGRESS_EVENT_SECRET=replace_with_a_different_32_char_secret
CONFIRMATION_SECRET=replace_with_at_least_32_random_characters

# Feishu identities and optional access boundaries
OWNER_OPEN_ID=ou_xxx
OWNER_NAME=韩飞龙
BOT_OPEN_ID=ou_bot_xxx
ALLOWED_TENANT_KEYS=
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

# LLM conversation agent
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Feishu application and requirement Base
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace_with_server_secret
BASE_SYNC_ENABLED=false
BASE_ADMIN_ENABLED=false
FEISHU_BASE_TOKEN=bascn_xxx
FEISHU_BASE_TABLE_ID=tbl_xxx
FEISHU_BASE_TABLE_LABEL=需求表
FEISHU_BASE_URL=
FEISHU_BASE_FIELD_MAP=

# Official MCP. For the bundled full-tool service, use the URL below and
# start Compose with --profile mcp. Leave disabled when MCP is not required.
MCP_ENABLED=false
MCP_URL=http://lark-mcp:3000/mcp
